# Copy to .env and adjust. All keys are prefixed RTV_.

# Where DuckDB + Parquet telemetry live.
RTV_DATA_DIR=./data

# Folder served at / and /review/. Unset = the repo's frontend/ (the desktop
# build points it at its bundled copy).
# RTV_FRONTEND_DIR=

# Live shared-memory poll rate (Hz). iRacing telemetry updates at 60 Hz.
RTV_POLL_HZ=60

# Arrays with count <= this are flattened into per-index columns (e.g. tyres = 4).
# Larger arrays (per-car-index = 64) are stored as LIST columns.
RTV_ARRAY_FLATTEN_MAX=6

# Telemetry flush cadence to Parquet (seconds of buffered samples).
RTV_FLUSH_SECONDS=0.5

# HTTP server bind.
RTV_HOST=127.0.0.1
RTV_PORT=8000

# Automatically start the live poller on server startup (Windows + iRacing only).
RTV_AUTOSTART_LIVE=false

# Log level: DEBUG, INFO, WARNING, ERROR
RTV_LOG_LEVEL=INFO

# --- v2 pitwall -------------------------------------------------------------
# Enable the deterministic race-state engine, /api/v1/racestate, /ws/pitwall
# and the replay driver. Set false to serve the v1 analysis surface alone.
RTV_PITWALL=true

# Recompute standings gaps every Nth frame (6 @ 60 Hz = 10 Hz). Cheaper state
# (player, flags, fuel level, tyres) still updates on every frame.
RTV_PITWALL_GAP_INTERVAL=6

# Green laps in the rolling fuel-consumption mean.
RTV_PITWALL_FUEL_LAPS=5

# Emit a stint_lap_milestone event every N green laps on the current tyre set.
# This is the strategist's periodic wake-up, and it is lap-driven, not timed.
RTV_PITWALL_STINT_MILESTONE_LAPS=5

# Laps of slack to the finish below which fuel_margin_low fires.
RTV_PITWALL_FUEL_MARGIN_LAPS=1.0

# --- deterministic aggregation (what wakes the stage-3 agents) --------------
# One lockup is a driver having a moment; the same one at the same corner three
# times in five laps is a finding. The aggregation happens here, in the engine,
# so no agent is ever woken by a single event.
#
# Lap fractions the track is split into when deciding "the same corner".
RTV_PITWALL_CORNER_BUCKETS=20
# Repeats before recurring_issue fires, and the lap window they must fall in.
RTV_PITWALL_RECURRENCE_MIN=3
RTV_PITWALL_RECURRENCE_WINDOW_LAPS=5

# Tyre bands. Absolute limits are per-car, so they are deliberately not set here:
# these two are *relative* measures and need no per-car knowledge.
# Degrees per lap of sustained temperature drift across a stint.
RTV_PITWALL_TYRE_TEMP_TREND_C=3.0
# Left-to-right temperature spread across one axle.
RTV_PITWALL_TYRE_AXLE_IMBALANCE_C=15.0

# Engine temperatures above which car_health_warning fires. The sim's own
# warning bits fire regardless of these.
RTV_PITWALL_OIL_TEMP_MAX_C=130
RTV_PITWALL_WATER_TEMP_MAX_C=105

# Track-position gap inside which a car counts as close, for the spotter. It
# still only fires when the car is measurably closing.
RTV_PITWALL_TRAFFIC_GAP_S=1.5

# --- v2 pitwall agents ------------------------------------------------------
# Mount the agent layer, the radio feed and /api/v1/pitwall/*. OFF by default
# because it spends money: a key exported for the Layer-3 coach must not
# silently start billing for live race radio. Also needs the "ai" extra and
# the LLM credential (KIMI_CODE_API_KEY by default); without either, the layer stays unmounted and says so on
# GET /api/v1/pitwall/status.
RTV_PITWALL_AGENTS=false

# Global kill switch applied at startup. Mount the layer but never invoke a
# model. Flip at runtime with POST /api/v1/pitwall/enabled.
RTV_PITWALL_AGENTS_LIVE=true

# --- LLM backend: Kimi Code ------------------------------------------------
# Every LLM layer (pitwall agents, coaching chat, orchestrator) talks
# to Kimi Code. Its endpoint speaks the Anthropic Messages format, so the
# anthropic SDK is the transport; nothing calls Anthropic. The ONLY thing you
# must supply is the credential:
#
#   KIMI_CODE_API_KEY=<your Kimi Code key>
#
# This is the Kimi Code (coding subscription) key, not a Moonshot developer-API
# key. KIMI_API_KEY is still read if KIMI_CODE_API_KEY is unset.
#
# Verify it before a race with:  python scripts/check_llm.py
RTV_LLM_KIMI_BASE_URL=https://api.kimi.com/coding
RTV_LLM_KIMI_MODEL_REASONING=kimi-k3
RTV_LLM_KIMI_MODEL_FAST=kimi-k3
#
# Overrides. Empty = the defaults above.
#   RTV_LLM_BASE_URL     another Anthropic-compatible Kimi endpoint
#   RTV_LLM_API_KEY_ENV  name of the env var holding the credential
RTV_LLM_BASE_URL=
RTV_LLM_API_KEY_ENV=

# Per-agent model ids. Unset or empty = RTV_LLM_KIMI_MODEL_REASONING for the
# strategist, RTV_LLM_KIMI_MODEL_FAST for the others. Switching one agent
# to another Kimi model is a config change, e.g. RTV_PITWALL_COACH_MODEL=kimi-k3.
# RTV_PITWALL_STRATEGIST_MODEL=
# RTV_PITWALL_VEHICLE_ENGINEER_MODEL=
# RTV_PITWALL_SPOTTER_MODEL=
# RTV_PITWALL_COACH_MODEL=
# RTV_PITWALL_RACE_CONTROL_MODEL=

# Seconds an agent's call may wait for the radio before it airs tagged
# "Late call:". Unset = the agent's default (strategist 30, vehicle engineer 20,
# spotter 3 for its template calls, coach 30, race control 15); 0 = never tagged late. A call that has stopped being true
# (its stop lap has passed, the car it is about has gone) is dropped regardless.
# RTV_PITWALL_STRATEGIST_MAX_AGE_S=
# RTV_PITWALL_VEHICLE_ENGINEER_MAX_AGE_S=
# RTV_PITWALL_SPOTTER_MAX_AGE_S=
# RTV_PITWALL_COACH_MAX_AGE_S=
# RTV_PITWALL_RACE_CONTROL_MAX_AGE_S=

# Mount a subset of the agents. Empty mounts all five (strategist,
# vehicle_engineer, spotter, coach, race_control). Comma-separated, no code change needed.
RTV_PITWALL_AGENTS_ONLY=

# --- eval judge (evals/ only) ------------------------------------------------
# The LLM judge in evals/run.py is the one place a non-Kimi model is used, so Kimi
# does not grade its own coach. gemini (default), anthropic or kimi.
#   GEMINI_API_KEY=<your Gemini API key>      for gemini (pip install -e ".[judge]")
#   ANTHROPIC_API_KEY=<your Anthropic key>    for anthropic (RTV_JUDGE_MODEL required)
RTV_JUDGE_PROVIDER=gemini
# Empty = gemini-3.1-pro-preview for gemini, RTV_LLM_KIMI_MODEL_REASONING for kimi.
RTV_JUDGE_MODEL=

# Cap on concurrent in-flight agent LLM calls (a safety-car burst must not fan
# out into a dozen simultaneous requests).
RTV_PITWALL_MAX_INFLIGHT=2

# Default minimum session-seconds between invocations per trigger type.
RTV_PITWALL_AGENT_COOLDOWN_S=30

# Seconds lost to a green-flag pit stop. This is the input to the deterministic
# rejoin-position projection, so it should match your car and track.
RTV_PITWALL_PIT_LANE_LOSS_S=25

# Radio messages kept in the ring buffer for late joiners.
RTV_PITWALL_RADIO_HISTORY=200
# Session seconds between race-state snapshots in the race journal (post-race replay).
RTV_JOURNAL_STATE_INTERVAL_S=1.0

# Consecutive failed invocations before an agent is taken off the air
# automatically. A revoked key or a retired model id would otherwise cost one
# doomed request per race event for the rest of the session; the reason is
# reported on GET /api/v1/pitwall/status and cleared by re-enabling the agent.
# 0 disables the circuit breaker.
RTV_PITWALL_AGENT_FAILURE_LIMIT=3

# Hard ceiling on billable model calls in ONE session, across every agent.
# Generous on purpose: this is a runaway guard, not a budget -- a normal race
# hour is a low-tens number (see the cost estimate in README.md). When it trips,
# the agents stand down, the deterministic layers keep running, and the counter
# is on GET /api/v1/pitwall/status. 0 = unlimited.
RTV_PITWALL_MAX_CALLS_PER_SESSION=400

# Session lifecycle autonomy (stage 07). True: the agents wait in standby, arm at
# the green flag of a session type listed below and stand down at the player's
# checkered flag or the session end. The kill switch and per-agent switches
# always win. Practice and qualifying arm only the agents on their roster
# (empty = none, so nothing bills for practice).
RTV_PITWALL_AUTONOMOUS=false
RTV_PITWALL_AUTONOMOUS_SESSIONS=race
RTV_PITWALL_ROSTER_PRACTICE=
RTV_PITWALL_ROSTER_QUALIFY=
# On each session end: none, or file (one-line result in the log plus a
# <run_id>.notice.txt beside the journal run). The <run_id>.summary.json is
# always written.
RTV_PITWALL_SESSION_END_NOTIFIER=none

# Post-race debrief (stage 09 part B): one Kimi call (thinking on) per race segment,
# after the session ends, never on the radio. AUTO: true, false, or auto (on whenever
# RTV_PITWALL_AGENTS is on); with no key it writes the deterministic half only.
# MODEL empty = RTV_LLM_KIMI_MODEL_REASONING.
RTV_DEBRIEF_AUTO=auto
RTV_DEBRIEF_SESSIONS=race
RTV_DEBRIEF_MODEL=

# Pause before the single retry of a failed model call. One retry only: a pit
# call that lands three corners late is worse than no call at all. After the
# retry fails, the agent says "Pitwall AI degraded" on the radio and the
# deterministic race state carries on untouched.
RTV_PITWALL_RETRY_BACKOFF_S=0.5

# Typed grounding: a figure an agent says with a unit ("6 laps", "P4", "28 psi")
# must match a fact of that unit family, not merely any nearby number in what it
# was shown. false falls back to the old any-number check (a rollback switch).
RTV_PITWALL_TYPED_GROUNDING=true

# --- v2 race director (stages 5 and 10: eval path only) ----------------------
# A ScenarioScript injects things that did not happen (a full-course yellow on
# lap 7, rain at half distance, a mandatory stop) so a strategist can be
# rehearsed against a race that never runs the same way twice.
#
# The app never runs a director: it keeps the NoopDirector, which injects
# NOTHING. Pointing this at a script therefore LINTS it (a malformed script
# fails at boot with a line number instead of three laps into a demo). To
# rehearse a script, run evals/run_director.py --out <dir> (its own journal,
# outside data/sessions). See docs/director_scenario.example.json and
# docs/PITWALL.md (the race director).
RTV_PITWALL_DIRECTOR_SCRIPT=

# --- v2 pitwall radio voice (stage 4) ---------------------------------------
# The pitwall's DEFAULT voice is the browser's Web Speech API: zero cost, zero
# setup, works offline. Everything below is the optional premium path. With
# RTV_PITWALL_TTS unset, RadioMessage.audio_url stays null and the frontend
# speaks for itself -- so leaving this whole block alone is a valid deployment.
#
# Provider name from the registry in src/rtv/pitwall/tts.py:
#   (empty)/none  browser Web Speech only
#   rest|openai   a JSON REST endpoint with an OpenAI-compatible /audio/speech body
# A vendor with a different body registers its own factory; see that module.
RTV_PITWALL_TTS=

# The speech endpoint and its bearer token. Missing either one makes the
# provider report itself unavailable (and say which), rather than failing at
# the first radio call.
RTV_PITWALL_TTS_URL=
RTV_PITWALL_TTS_API_KEY=

# Vendor model id, requested audio format, and the Content-Type served for it.
RTV_PITWALL_TTS_MODEL=
RTV_PITWALL_TTS_FORMAT=mp3
RTV_PITWALL_TTS_MEDIA_TYPE=audio/mpeg

# Per-agent vendor voice overrides. Empty uses the built-in role voices, which
# are already distinct by voice, rate and pitch so the strategist and the
# spotter are told apart by ear.
RTV_PITWALL_TTS_VOICES=

# Timeout on one synthesis request, and how many clips are kept in memory
# (keyed by the content-derived message id, so a replay never pays twice).
RTV_PITWALL_TTS_TIMEOUT_S=8
RTV_PITWALL_TTS_CACHE=64

# The coaching chat (POST /api/v1/coaching/chat) uses the same Kimi backend and
# RTV_LLM_KIMI_MODEL_REASONING. Without a key it returns 503 and everything else
# still works.

# --- Vision: onboard video and VLM visual notes (docs/VISION.md) -------------
# off: no VLM calls (registering videos, sync, frames and dry-run plans still
# work). post: post-race analyses may call Kimi (uses the Kimi Code quota).
# live: post, plus kept notes for the session the engine is consuming are
# published as low-priority visual_observation events for the spotter and coach.
RTV_VISION_MODE=off
# Empty = RTV_LLM_KIMI_MODEL_REASONING (kimi-k3).
RTV_VISION_MODEL=
# Frame budget per analysis, frames per moment, and the width frames are
# scaled to before they are sent.
RTV_VISION_MAX_FRAMES=60
RTV_VISION_FRAMES_PER_MOMENT=4
RTV_VISION_FRAME_WIDTH=768
# ffmpeg and ffprobe (names on PATH, or full paths).
RTV_VISION_FFMPEG=ffmpeg
RTV_VISION_FFPROBE=ffprobe
# Live capture (RTV_VISION_MODE=live, docs/VISION.md "Live"): ffmpeg input args
# (default: the iRacing window via gdigrab), record an MP4 and register it synced,
# preview fps, seconds kept in memory, latency to take off each stamp, and whether
# to start capturing on its own when a live session begins.
RTV_VISION_CAPTURE_INPUT='-f gdigrab -framerate 30 -draw_mouse 0 -i "title=iRacing.com Simulator"'
RTV_VISION_CAPTURE_RECORD=true
RTV_VISION_CAPTURE_PREVIEW_FPS=10
RTV_VISION_CAPTURE_RING_S=20
RTV_VISION_CAPTURE_LAG_S=0
RTV_VISION_CAPTURE_AUTO=false
# Live VLM: which race events send frames to Kimi, the call cap per session run
# (0 = off; each call uses the Kimi Code quota) and the merge gap.
RTV_VISION_LIVE_TRIGGERS=incident,offtrack,lockup
RTV_VISION_LIVE_MAX_CALLS=10
RTV_VISION_LIVE_MIN_GAP_S=5
# Live visual notes wake the spotter/coach on the radio (default: review material only).
RTV_VISION_LIVE_RADIO=false

# --- Push-to-talk voice questions (RTV Desktop; needs the [voice] extra) -------
# Hold the key, ask ("how many laps of fuel?"), let go. Speech-to-text runs locally
# with faster-whisper on the CPU; no audio leaves the PC. docs/DESKTOP.md has the steps.
RTV_VOICE_ENABLED=false
# A key name (ScrollLock, Pause, F13, RCtrl, Numpad0...) or a wheel button: joy1:5.
RTV_VOICE_KEY=ScrollLock
# base.en (~150 MB, quick on a CPU) or small.en (~480 MB, more accurate).
RTV_VOICE_MODEL=base.en
