# Copy to .env and adjust. All keys are prefixed RTV_.

# Where DuckDB + Parquet telemetry live.
RTV_DATA_DIR=./data

# Live shared-memory poll rate (Hz). iRacing telemetry updates at 60 Hz.
RTV_POLL_HZ=60

# Arrays with count <= this are flattened into per-index columns (e.g. tyres = 4).
# Larger arrays (per-car-index = 64) are stored as LIST columns.
RTV_ARRAY_FLATTEN_MAX=6

# Telemetry flush cadence to Parquet (seconds of buffered samples).
RTV_FLUSH_SECONDS=0.5

# HTTP server bind.
RTV_HOST=127.0.0.1
RTV_PORT=8000

# Automatically start the live poller on server startup (Windows + iRacing only).
RTV_AUTOSTART_LIVE=false

# Seed a simulated demo session on startup when the store is empty, so the
# frontend has real chart + coaching data without an imported .ibt file.
RTV_SEED_DEMO=true

# Log level: DEBUG, INFO, WARNING, ERROR
RTV_LOG_LEVEL=INFO

# --- coaching LLM (POST /api/v1/coaching/chat) -----------------------------
# The chatbot uses the Anthropic API. Set your key to enable it; without it the
# endpoint returns 503 and the rest of the app still works.
# ANTHROPIC_API_KEY=sk-ant-...
# RTV_COACHING_MODEL=claude-opus-4-8
