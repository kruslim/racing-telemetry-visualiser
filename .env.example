# Copy to .env and adjust. All keys are prefixed RTV_.

# Where DuckDB + Parquet telemetry live.
RTV_DATA_DIR=./data

# Live shared-memory poll rate (Hz). iRacing telemetry updates at 60 Hz.
RTV_POLL_HZ=60

# Arrays with count <= this are flattened into per-index columns (e.g. tyres = 4).
# Larger arrays (per-car-index = 64) are stored as LIST columns.
RTV_ARRAY_FLATTEN_MAX=6

# Telemetry flush cadence to Parquet (seconds of buffered samples).
RTV_FLUSH_SECONDS=0.5

# HTTP server bind.
RTV_HOST=127.0.0.1
RTV_PORT=8000

# Automatically start the live poller on server startup (Windows + iRacing only).
RTV_AUTOSTART_LIVE=false

# Log level: DEBUG, INFO, WARNING, ERROR
RTV_LOG_LEVEL=INFO

# --- v2 pitwall -------------------------------------------------------------
# Enable the deterministic race-state engine, /api/v1/racestate, /ws/pitwall
# and the replay driver. Set false to serve the v1 analysis surface alone.
RTV_PITWALL=true

# Recompute standings gaps every Nth frame (6 @ 60 Hz = 10 Hz). Cheaper state
# (player, flags, fuel level, tyres) still updates on every frame.
RTV_PITWALL_GAP_INTERVAL=6

# Green laps in the rolling fuel-consumption mean.
RTV_PITWALL_FUEL_LAPS=5

# Emit a stint_lap_milestone event every N green laps on the current tyre set.
# This is the strategist's periodic wake-up, and it is lap-driven, not timed.
RTV_PITWALL_STINT_MILESTONE_LAPS=5

# Laps of slack to the finish below which fuel_margin_low fires.
RTV_PITWALL_FUEL_MARGIN_LAPS=1.0

# --- deterministic aggregation (what wakes the stage-3 agents) --------------
# One lockup is a driver having a moment; the same one at the same corner three
# times in five laps is a finding. The aggregation happens here, in the engine,
# so no agent is ever woken by a single event.
#
# Lap fractions the track is split into when deciding "the same corner".
RTV_PITWALL_CORNER_BUCKETS=20
# Repeats before recurring_issue fires, and the lap window they must fall in.
RTV_PITWALL_RECURRENCE_MIN=3
RTV_PITWALL_RECURRENCE_WINDOW_LAPS=5

# Tyre bands. Absolute limits are per-car, so they are deliberately not set here:
# these two are *relative* measures and need no per-car knowledge.
# Degrees per lap of sustained temperature drift across a stint.
RTV_PITWALL_TYRE_TEMP_TREND_C=3.0
# Left-to-right temperature spread across one axle.
RTV_PITWALL_TYRE_AXLE_IMBALANCE_C=15.0

# Engine temperatures above which car_health_warning fires. The sim's own
# warning bits fire regardless of these.
RTV_PITWALL_OIL_TEMP_MAX_C=130
RTV_PITWALL_WATER_TEMP_MAX_C=105

# Track-position gap inside which a car counts as close, for the spotter. It
# still only fires when the car is measurably closing.
RTV_PITWALL_TRAFFIC_GAP_S=1.5

# --- v2 pitwall agents ------------------------------------------------------
# Mount the agent layer, the radio feed and /api/v1/pitwall/*. OFF by default
# because it spends money: a key exported for the Layer-3 coach must not
# silently start billing for live race radio. Also needs the "ai" extra and
# ANTHROPIC_API_KEY; without either, the layer stays unmounted and says so on
# GET /api/v1/pitwall/status.
RTV_PITWALL_AGENTS=false

# Global kill switch applied at startup. Mount the layer but never invoke a
# model. Flip at runtime with POST /api/v1/pitwall/enabled.
RTV_PITWALL_AGENTS_LIVE=true

# Model tiers. High-frequency, low-stakes agents run on the fast model; strategy
# is worth a reasoning model because it runs a handful of times a race.
RTV_PITWALL_AGENT_MODEL_FAST=claude-haiku-4-5-20251001
RTV_PITWALL_AGENT_MODEL_REASONING=claude-sonnet-4-6

# Per-agent overrides. Empty = the tier above (reasoning for the strategist,
# fast for the other three).
RTV_PITWALL_STRATEGIST_MODEL=
RTV_PITWALL_VEHICLE_ENGINEER_MODEL=
RTV_PITWALL_SPOTTER_MODEL=
RTV_PITWALL_COACH_MODEL=

# Mount a subset of the agents. Empty mounts all four (strategist,
# vehicle_engineer, spotter, coach). Comma-separated, no code change needed.
RTV_PITWALL_AGENTS_ONLY=

# Cap on concurrent in-flight agent LLM calls (a safety-car burst must not fan
# out into a dozen simultaneous requests).
RTV_PITWALL_MAX_INFLIGHT=2

# Default minimum session-seconds between invocations per trigger type.
RTV_PITWALL_AGENT_COOLDOWN_S=30

# Seconds lost to a green-flag pit stop. This is the input to the deterministic
# rejoin-position projection, so it should match your car and track.
RTV_PITWALL_PIT_LANE_LOSS_S=25

# Radio messages kept in the ring buffer for late joiners.
RTV_PITWALL_RADIO_HISTORY=200
